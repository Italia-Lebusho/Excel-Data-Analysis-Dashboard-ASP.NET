@model Markerting.Models.GenericDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid px-0">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="display-5 fw-semibold mb-2">Spreadsheet insights</h1>
            <p class="lead text-muted mb-0">Upload a workbook (.xlsx), choose what to analyze, then open the dashboard tailored to that question.</p>
        </div>
    </div>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-gradient-header text-white py-3">
            <h2 class="h5 mb-0">Upload workbook</h2>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <form asp-action="UploadExcel" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label">Excel file</label>
                    <input type="file" name="file" class="form-control" accept=".xlsx,.xls" required />
                    <small class="text-muted">First sheet is used. Row 1 (or the densest early row) is treated as headers. <strong>.xlsx</strong> is recommended.</small>
                </div>
                <div class="col-md-4 d-grid">
                    <button type="submit" class="btn btn-accent btn-lg">Upload file</button>
                </div>
            </form>
            @if (Model.HasData)
            {
                <div class="mt-3 d-flex flex-wrap gap-2 justify-content-center">
                    <a asp-action="AnalyzeSetup" class="btn btn-outline-primary">Change what we analyze</a>
                    <a asp-action="ExportGeneric" class="btn btn-outline-secondary">Download data + column profile (.xlsx)</a>
                </div>
            }
        </div>
    </div>

    @if (!Model.HasData)
    {
        <div class="alert alert-light border text-center">
            <p class="mb-0 text-muted">No file loaded yet. Choose a spreadsheet above to see KPIs, automatic charts, and a data preview.</p>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            @foreach (var kpi in Model.Kpis)
            {
                <div class="col-6 col-md-4 col-xl-3">
                    <div class="card h-100 text-white border-0 shadow-sm @kpi.CssClass">
                        <div class="card-body">
                            <div class="small text-white-50 text-uppercase">@kpi.Label</div>
                            <div class="fs-4 fw-semibold">@kpi.Value</div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.FileName.Length > 0)
        {
            <p class="text-muted small text-center mb-4">
                <strong>@Model.FileName</strong> · sheet <em>@Model.SheetName</em> · @Model.RowCount.ToString("N0") rows × @Model.ColumnCount columns
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.AnalysisPlanSummary))
        {
            <div class="alert alert-info border-0 shadow-sm mb-4">
                <div class="fw-semibold mb-1">Your analysis question</div>
                <p class="mb-0">@Model.AnalysisPlanSummary</p>
            </div>
        }

        @if (Model.FinalComparison.Count > 0)
        {
            var isCompare = Model.AnalysisRequest?.Goal == Markerting.Models.AnalysisGoalKind.CompareGroups;
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header bg-white fw-semibold">Results table</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@(isCompare ? "Metric" : "Item")</th>
                                    <th>@(isCompare ? (Model.AnalysisRequest?.CompareValueA ?? "A") : "Primary")</th>
                                    <th>@(isCompare ? (Model.AnalysisRequest?.CompareValueB ?? "B") : "Secondary")</th>
                                    @if (isCompare)
                                    {
                                        <th>Note</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.FinalComparison)
                                {
                                    <tr>
                                        <td>@row.Metric</td>
                                        <td>@row.ValueA</td>
                                        <td>@row.ValueB</td>
                                        @if (isCompare)
                                        {
                                            <td class="small text-muted">@(row.Note ?? "—")</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (Model.InsightStory != null)
        {
            <div class="card shadow-sm mb-4 border-0 insight-story-card">
                <div class="card-body">
                    <h2 class="h5 fw-semibold mb-2">Short story from your data</h2>
                    <p class="lead fs-6 mb-3">@Model.InsightStory.Teaser</p>
                    @if (Model.InsightStory.Observations.Count > 0)
                    {
                        <h3 class="h6 text-uppercase text-muted mb-2">What seems to be going on</h3>
                        <ul class="mb-4">
                            @foreach (var line in Model.InsightStory.Observations)
                            {
                                <li class="mb-2">@line</li>
                            }
                        </ul>
                    }
                    @if (Model.InsightStory.Recommendations.Count > 0)
                    {
                        <h3 class="h6 text-uppercase text-muted mb-2">How to tackle it</h3>
                        <ol class="mb-0 ps-3">
                            @foreach (var step in Model.InsightStory.Recommendations)
                            {
                                <li class="mb-2">@step</li>
                            }
                        </ol>
                    }
                    <p class="small text-muted mt-3 mb-0">This narrative is generated from column types, missing values, concentration, and simple time patterns in your upload. Use it as a starting point—not as a substitute for your own judgment or professional advice.</p>
                </div>
            </div>
        }

        @if (Model.Charts.Count > 0)
        {
            <div class="row g-4 mb-4">
                @foreach (var chart in Model.Charts)
                {
                    <div class="col-lg-6">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-header bg-white border-bottom-0 fw-semibold">@chart.Title</div>
                            <div class="card-body pt-0">
                                <canvas id="@chart.Id" height="260"></canvas>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="row g-4 mb-4">
            <div class="col-lg-7">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-semibold">Column summary</div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-striped mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Column</th>
                                        <th>Type</th>
                                        <th>Non-empty</th>
                                        <th>Profile</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Model.Columns)
                                    {
                                        <tr>
                                            <td>@c.Name</td>
                                            <td><span class="badge rounded-pill bg-light text-dark border">@c.Kind</span></td>
                                            <td>@c.NonEmptyCount</td>
                                            <td class="small">
                                                @if (c.Kind == Markerting.Models.GenericColumnKind.Number)
                                                {
                                                    <text>Sum @c.Sum?.ToString("N2") · Avg @c.Average?.ToString("N2") · Min @c.Min?.ToString("N2") · Max @c.Max?.ToString("N2")</text>
                                                }
                                                else if (c.Kind == Markerting.Models.GenericColumnKind.Date)
                                                {
                                                    <text>@c.DateMin → @c.DateMax</text>
                                                }
                                                else
                                                {
                                                    <text>~@c.DistinctApprox distinct</text>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-semibold">Preview (first rows)</div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 420px;">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        @foreach (var h in Model.Columns.Select(x => x.Name))
                                        {
                                            <th class="text-nowrap small">@h</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.PreviewRows)
                                    {
                                        <tr>
                                            @foreach (var col in Model.Columns)
                                            {
                                                <td class="small">@(row.TryGetValue(col.Name, out var v) ? v : "")</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @if (Model.HasData && Model.Charts.Count > 0)
    {
        <script>
            const chartSpecs = @Html.Raw(Json.Serialize(Model.Charts));
            const palette = [
                'rgba(59, 130, 246, 0.75)',
                'rgba(16, 185, 129, 0.75)',
                'rgba(244, 114, 182, 0.75)',
                'rgba(251, 191, 36, 0.85)',
                'rgba(139, 92, 246, 0.75)',
                'rgba(14, 165, 233, 0.75)',
                'rgba(248, 113, 113, 0.75)',
                'rgba(148, 163, 184, 0.85)'
            ];

            chartSpecs.forEach((spec, idx) => {
                const chartId = spec.id ?? spec.Id;
                const canvas = document.getElementById(chartId);
                if (!canvas || !window.Chart) return;
                const type = (String(spec.chartType ?? spec.ChartType ?? 'bar')).toLowerCase();
                const labels = spec.labels ?? spec.Labels ?? [];
                const rawDatasets = spec.datasets ?? spec.Datasets ?? [];
                const datasets = rawDatasets.map((ds, i) => ({
                    label: ds.label ?? ds.Label ?? 'Series',
                    data: (ds.data ?? ds.Data ?? []).map(v => Number(v)),
                    backgroundColor: type === 'line'
                        ? palette[(idx + i) % palette.length].replace('0.75', '0.2').replace('0.85', '0.25')
                        : palette[(idx + i) % palette.length],
                    borderColor: palette[(idx + i) % palette.length].replace('0.75', '1').replace('0.85', '1'),
                    borderWidth: type === 'line' ? 2 : 1,
                    tension: 0.35,
                    fill: type === 'line'
                }));

                new Chart(canvas.getContext('2d'), {
                    type: type,
                    data: { labels, datasets },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom' },
                            title: { display: false }
                        },
                        scales: type === 'doughnut' ? {} : {
                            x: { ticks: { autoSkip: true, maxRotation: 40, minRotation: 0 } },
                            y: { beginAtZero: true }
                        }
                    }
                });
            });
        </script>
    }
}
